<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_luxury_gold_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- TIÊU ĐỀ & VÒNG TRÒN CẢM BIẾN R503 GOLD -->
    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/r503_gold_ring">

        <ImageView
            android:id="@+id/ivEnrollIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_fingerprint"
            app:tint="@color/gold_primary" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvEnrollTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LẤY MẪU VÂN TAY R503"
        android:textColor="@color/white"
        android:textSize="17sp"
        android:textStyle="bold"
        android:letterSpacing="0.04" />

    <TextView
        android:id="@+id/tvEnrollFingerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="14dp"
        android:text="Tên: Ngón cái phải"
        android:textColor="@color/gold_primary"
        android:textSize="13sp"
        android:fontFamily="monospace" />

    <!-- THANH TIẾN TRÌNH LẤY MẪU ĐA ĐIỂM (5 LẦN NHƯ SMARTPHONE) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tvEnrollTouchCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Lần chạm: 1 / 5"
                android:textColor="@color/gold_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEnrollPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20%"
                android:textColor="@color/gold_primary"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pbEnrollProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:max="5"
            android:progress="1"
            android:progressTint="@color/gold_primary" />
    </LinearLayout>

    <!-- CARD HƯỚNG DẪN BƯỚC HIỆN TẠI (OBSIDIAN & GOLD BORDER) -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        app:cardBackgroundColor="@color/obsidian_card"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/tvEnrollStepDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Bước 1: Hãy chạm ngón tay lên cảm biến\n(Vòng LED cảm biến đang thở màu tím)"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />

            <!-- THANH ĐẾM NGƯỢC 60 GIÂY MÀU VÀNG GOLD -->
            <ProgressBar
                android:id="@+id/pbEnrollTimer"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="16dp"
                android:max="60"
                android:progress="60"
                android:progressTint="@color/gold_primary" />

            <TextView
                android:id="@+id/tvEnrollTimerText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Thời gian chờ: 60s"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:fontFamily="monospace" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- NÚT HỦY BỎ -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnCancelEnroll"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/header_icon_btn_bg"
        android:text="Hủy Bỏ"
        android:textAllCaps="false"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

</LinearLayout>
