<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_luxury_gold_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- ICON & HEADER -->
        <FrameLayout
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/r503_gold_ring">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_shield"
                app:tint="@color/gold_primary" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NÂNG CẤP FIRMWARE (OTA)"
            android:textColor="@color/gold_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="Cập nhật phần mềm ESP32-C3 qua Bluetooth LE"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <!-- KHỐI CHỌN FILE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/header_icon_btn_bg"
            android:orientation="vertical"
            android:padding="14dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BẢN NẠP FIRMWARE (.BIN)"
                android:textColor="@color/gold_bright"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSelectFile"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@drawable/card_telemetry_bg"
                android:text="📁 Chọn file firmware (.bin)"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvFileInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chưa chọn file firmware nào"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvFileMd5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="MD5: --"
                android:textColor="@color/text_muted"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:visibility="gone" />
        </LinearLayout>

        <!-- KHỐI AN TOÀN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_danger_bg"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️ QUY TẮC AN TOÀN BẮT BUỘC:"
                android:textColor="@color/accent_danger"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Tắt khóa điện xe (ACC OFF) trước khi bắt đầu.\n• Giữ điện thoại gần xe (dưới 2 mét).\n• Không tắt Bluetooth hoặc chuyển app khi đang nạp."
                android:textColor="@color/white"
                android:textSize="11sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

        <!-- KHỐI TIẾN TRÌNH NẠP (HIỆN KHI BẮT ĐẦU) -->
        <LinearLayout
            android:id="@+id/layoutOtaProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/header_icon_btn_bg"
            android:orientation="vertical"
            android:padding="14dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tvOtaStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Đang chuẩn bị..."
                    android:textColor="@color/gold_bright"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvOtaPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="@color/gold_bright"
                    android:textSize="14sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressBarOta"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/gold_primary"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvOtaSpeed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0 KB / 0 KB (0.0 KB/s)"
                android:textColor="@color/text_muted"
                android:textSize="10sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- ACTION BUTTONS -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnStartOta"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/btn_gold_hero"
            android:text="⚡ BẮT ĐẦU CẬP NHẬT FIRMWARE"
            android:textAllCaps="false"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold"
            android:enabled="false"
            android:layout_marginBottom="10dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCancelOta"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/header_icon_btn_bg"
            android:text="Đóng"
            android:textAllCaps="false"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
